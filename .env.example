# Copy to .env.local and adjust as needed (both are gitignored).

# Fallback for the interactive map view, used ONLY when Supabase isn't configured below (e.g.
# a fresh clone with no credentials yet) or its request fails. Whenever Supabase IS configured
# and reachable, its `feature_flags` row (supabase/schema.sql) always wins over this — that's
# the point of it being a real kill switch, flip it off there and it's off for everyone.
# VITE_ENABLE_MAP=true

# Supabase project (Settings -> API in the Supabase dashboard). The anon key is meant to be
# public — access is controlled by RLS (see supabase/schema.sql), not by keeping this secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
